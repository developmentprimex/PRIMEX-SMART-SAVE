<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="PrimEx Smart Save" Manufacturer="PrimEx" Version="$(var.ProductVersion)" UpgradeCode="74FC93D4-971F-4D60-8FA7-226C2AB7E5AE" Scope="perUser" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of PrimEx Smart Save is already installed." Schedule="afterInstallInitialize"/>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
    <Launch Condition="VersionNT64" Message="PrimEx Smart Save requires 64-bit Windows."/>
    <StandardDirectory Id="LocalAppDataFolder"><Directory Id="PrimExFolder" Name="PrimEx"><Directory Id="INSTALLFOLDER" Name="SmartSaveApp"><Directory Id="DesktopDir" Name="Desktop"/>
      <?ifdef BrowserIntegration ?><Directory Id="NativeHostDir" Name="NativeHost"/><?endif?>
    </Directory></Directory></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="ProgramMenuDir" Name="PrimEx Smart Save"/></StandardDirectory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="UserIntegration" Guid="B8773B57-53A4-4436-B619-12FA53CE5F21">
        <RegistryValue Root="HKCU" Key="Software\PrimEx\SmartSave" Name="InstallFolder" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes"/>
        <RegistryValue Root="HKCU" Key="Software\PrimEx\SmartSave" Name="Version" Value="$(var.ProductVersion)" Type="string"/>
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="PrimEx Smart Save" Value="&quot;[DesktopDir]PrimEx.SmartSave.Desktop.exe&quot; --startup --background" Type="string"/>
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall"/>
        <RemoveFolder Id="RemovePrimExFolder" Directory="PrimExFolder" On="uninstall"/>
      </Component>
      <?ifdef BrowserIntegration ?>
      <Component Id="BrowserRegistration" Guid="4DF09488-4C78-4E80-A704-27D794B51B2B">
        <File Id="NativeManifest" Source="$(var.PayloadRoot)\native-host.json"/>
        <RegistryValue Root="HKCU" Key="Software\Google\Chrome\NativeMessagingHosts\com.primex.smartsave" Value="[INSTALLFOLDER]native-host.json" Type="string" KeyPath="yes"/>
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Edge\NativeMessagingHosts\com.primex.smartsave" Value="[INSTALLFOLDER]native-host.json" Type="string"/>
      </Component>
      <?endif?>
    </DirectoryRef>
    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="StartMenuIntegration" Guid="C6939831-7FF5-4AA1-8248-360D137E8B22">
        <RegistryValue Root="HKCU" Key="Software\PrimEx\SmartSave" Name="StartMenuShortcut" Value="1" Type="integer" KeyPath="yes"/>
        <Shortcut Id="StartMenuShortcut" Name="PrimEx Smart Save" Target="[DesktopDir]PrimEx.SmartSave.Desktop.exe" WorkingDirectory="DesktopDir"/>
        <RemoveFolder Id="RemoveMenuFolder" On="uninstall"/>
      </Component>
    </DirectoryRef>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopIntegration" Guid="72948BD0-6BEA-421C-91CB-BE0B3BEAC492">
        <RegistryValue Root="HKCU" Key="Software\PrimEx\SmartSave" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes"/>
        <Shortcut Id="DesktopShortcut" Name="PrimEx Smart Save" Target="[DesktopDir]PrimEx.SmartSave.Desktop.exe" WorkingDirectory="DesktopDir"/>
      </Component>
    </StandardDirectory>
    <Feature Id="Main" Title="PrimEx Smart Save" Level="1">
      <ComponentGroupRef Id="PayloadFiles"/><ComponentRef Id="UserIntegration"/><ComponentRef Id="StartMenuIntegration"/><ComponentRef Id="DesktopIntegration"/>
      <?ifdef BrowserIntegration ?><ComponentRef Id="BrowserRegistration"/><?endif?>
    </Feature>
    <ui:WixUI Id="WixUI_Minimal"/>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.DeploymentNotice)"/>
  </Package>
</Wix>
