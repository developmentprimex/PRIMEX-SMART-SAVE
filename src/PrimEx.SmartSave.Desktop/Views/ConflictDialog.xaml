<Window x:Class="PrimEx.SmartSave.Desktop.Views.ConflictDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Filename conflict" Width="510" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="24"><TextBlock Text="A file with this name already exists." FontSize="19" TextWrapping="Wrap"/><TextBlock Text="Keep both files, or explicitly replace the existing document. Replacement retains a recovery backup." TextWrapping="Wrap" Margin="0,12"/>
    <Button Content="_Keep both files" IsDefault="True" Click="KeepBoth"/><Button Content="_Replace existing file…" Click="Replace"/><Button Content="Cancel" IsCancel="True"/>
  </StackPanel>
</Window>
