<Window x:Class="PrimEx.SmartSave.Desktop.Views.EditorIntegrationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Connect your editors — PrimEx Smart Save" Style="{StaticResource {x:Type Window}}" Width="600" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="24">
    <TextBlock Text="Connect once, protect every project" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Brand}" TextWrapping="Wrap"/>
    <TextBlock Text="Install the link once in each editor you use. Every local folder or solution you open is then registered automatically, including new projects without Git. Files created by Codex, builds or other tools inside that workspace stay there without a placement prompt." TextWrapping="Wrap" Margin="0,12"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Visual Studio Code" FontWeight="SemiBold"/><Button x:Name="CodeButton" Content="Connect VS Code" Click="ConnectCode" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/><TextBlock Text="After installation, reload existing VS Code windows once. New projects connect automatically." TextWrapping="Wrap" Foreground="#617586"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Visual Studio 2022 (17.14+) / 2026 — x64" FontWeight="SemiBold"/><Button x:Name="StudioButton" Content="Connect Visual Studio" Click="ConnectStudio" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Complete the extension installer, then restart Visual Studio once. Open Folder and solutions are supported." TextWrapping="Wrap" Foreground="#617586"/></StackPanel></Border>
    <TextBlock Text="Keep ‘Skip coding projects automatically’ enabled in Automatic guidance. Files outside the open workspaces still receive normal guidance." TextWrapping="Wrap" Foreground="#617586" Margin="0,10"/>
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,6"/>
    <Button Content="Close" IsCancel="True" HorizontalAlignment="Right"/>
  </StackPanel>
</Window>
