<Window x:Class="PrimEx.SmartSave.Desktop.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PrimEx Smart Save — Document Storage Manager" Width="920" Height="590" MinWidth="700" MinHeight="440" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="PrimEx Smart Save" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Brand}"/><TextBlock Text="Document Storage Manager" Foreground="#617586" Margin="0,4,0,10"/><TextBlock Text="{Binding GuidanceStatus}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/><WrapPanel><Button Content="_Automatic guidance…" Click="AutomaticGuidance" Style="{StaticResource PrimaryButton}"/><Button Content="_Move a file…" Click="MoveFile"/><Button Content="_Review selected" Click="Review"/><Button Content="_Retry after review…" Click="Retry"/><Button Content="Cancel _transfer" Click="CancelTransfer"/><Button Content="_Settings" Click="Settings"/><Button Content="Export diagnostics…" Click="Diagnostics"/></WrapPanel></StackPanel>
  <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
  <DataGrid x:Name="Queue" ItemsSource="{Binding Operations}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,16" AutomationProperties.Name="Pending operations"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding Request.DisplayName}" Width="*"/><DataGridTextColumn Header="Integration" Binding="{Binding Request.Integration}" Width="110"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="130"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="2*"/></DataGrid.Columns></DataGrid>
  </DockPanel>
</Window>
