<Window x:Class="PrimEx.SmartSave.Desktop.Views.PostSaveDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Downloads or Files PX" Style="{StaticResource {x:Type Window}}" Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Window.InputBindings><KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}"/></Window.InputBindings>
  <Window.CommandBindings><CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="Cancel"/></Window.CommandBindings>
  <StackPanel Margin="24">
    <TextBlock Text="Where would you like to keep this file?" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="FileLabel" TextWrapping="Wrap" Margin="0,12"/>
    <TextBlock Text="Files PX moves the file to a company folder. Downloads keeps it in its current local folder. Close the document before moving." TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Button x:Name="MoveButton" Content="_Files PX" Click="Move" Style="{StaticResource PrimaryButton}" ToolTip="Move to a folder on the company server"/>
    <Button x:Name="KeepButton" Content="_Downloads" Click="Keep" IsDefault="True" ToolTip="Keep the file in its current local folder"/>
    <TextBlock Text="Keeping it here remembers this location for later saves to the same file, including after restarting Smart Save." TextWrapping="Wrap" Foreground="#617586" FontSize="12" Margin="0,10,0,0"/>
  </StackPanel>
</Window>
