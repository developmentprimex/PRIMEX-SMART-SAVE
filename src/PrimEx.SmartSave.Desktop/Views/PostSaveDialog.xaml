<Window x:Class="PrimEx.SmartSave.Desktop.Views.PostSaveDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Document saved outside company server" Style="{StaticResource {x:Type Window}}" Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"><StackPanel Margin="24"><TextBlock Text="This document was saved outside the company server." FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="FileLabel" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Would you like to move it to the company server or keep it here? Close the document in its application before moving." TextWrapping="Wrap" Margin="0,0,0,16"/><Button x:Name="MoveButton" Content="_Move to Company Server" Click="Move" Style="{StaticResource PrimaryButton}"/><Button Content="_Keep Current Location" IsCancel="True" IsDefault="True"/></StackPanel></Window>
