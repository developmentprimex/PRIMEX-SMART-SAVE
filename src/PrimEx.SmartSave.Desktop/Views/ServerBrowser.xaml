<Window x:Class="PrimEx.SmartSave.Desktop.Views.ServerBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Company server folders" Style="{StaticResource {x:Type Window}}" Width="650" Height="520" MinWidth="450" MinHeight="350" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20"><StackPanel x:Name="BrowserPanel" DockPanel.Dock="Top"><TextBlock x:Name="Heading" Text="Company Server" FontSize="22" FontWeight="SemiBold"/><StackPanel x:Name="FileNamePanel" Visibility="Collapsed" Margin="0,10,0,0"><Label Content="File _name" Target="{Binding ElementName=FileNameBox}"/><TextBox x:Name="FileNameBox" AutomationProperties.Name="File to move"/><TextBlock Text="Choose a company folder below, then click Move here. The file stays in its current location until you confirm." TextWrapping="Wrap" Foreground="#617586"/></StackPanel><ComboBox x:Name="Roots" DisplayMemberPath="Label" SelectionChanged="RootChanged" Margin="0,12" AutomationProperties.Name="Approved server roots"/><TextBox x:Name="CurrentPath" IsReadOnly="True" AutomationProperties.Name="Current server folder"/><StackPanel Orientation="Horizontal"><Button Content="_Up" Click="GoUp"/><Button Content="_New folder…" Click="NewFolder"/></StackPanel></StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="#B42318" Margin="0,8"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/><Button x:Name="SelectButton" Content="_Select folder" IsDefault="True" Click="Select"/></StackPanel></StackPanel>
  <ListBox x:Name="Folders" MouseDoubleClick="OpenFolder" AutomationProperties.Name="Server subfolders" KeyDown="FolderKeyDown"/></DockPanel>
</Window>
